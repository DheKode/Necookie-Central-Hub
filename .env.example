# Root-level environment variables.
#
# `mobile/app.config.js` reads this file as a fallback source for Supabase
# config if EXPO_PUBLIC_* variables are not set in the shell/CI environment.
# It is not required by `client/` or `server/`, which each load their own
# `.env` file instead (see client/.env.example and server/.env.example).
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Only needed at the root if you run AI-related tooling from here; the
# server reads its own copy from server/.env.
OPENAI_API_KEY=your_openai_api_key
